# Copy to .env. Never put secret keys in chat or public/*.js.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional paid alternative: AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
KAKAO_REST_API_KEY=
# Public, domain-restricted browser SDK key. Not the REST key.
KAKAO_JAVASCRIPT_KEY=
SUPABASE_URL=
# Supabase publishable key or legacy anon key; NEVER a service_role key.
SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://127.0.0.1:4173
PORT=4173
AI_DAILY_LIMIT=100
# live blocks sample fallback for missing AI/place providers.
APP_MODE=demo
HOST=127.0.0.1
# Add the Android WebView origin only when connecting the app to this server.
APP_ALLOWED_ORIGINS=
