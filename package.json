{
  "name": "eodigaji-beta",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/planner.mjs && node --check public/app.js",
    "build:mobile": "node scripts/build-mobile.mjs",
    "android:sync": "npm run build:mobile && cap sync android",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:open": "cap open ios",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "preview:mobile": "node scripts/preview-mobile.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2"
  }
}
